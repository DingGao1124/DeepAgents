# The LangGraph dev server reads this file (referenced by langgraph.json).
# Copy to .env — it can stay empty for local dev.

# Required: DeepSeek model access.
DEEPSEEK_API_KEY=

# Public base URL used in real preview links returned by create_preview.
AGENT_PUBLIC_URL=http://localhost:2024

# Optional absolute path for skills, drafts, artifacts and preview files.
# AGENT_WORKSPACE_ROOT=/absolute/path/to/workspace

# Optional: LangSmith tracing (see the agent run in the Studio UI).
# LANGSMITH_API_KEY=lsv2...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=eva-activity-page-agent
