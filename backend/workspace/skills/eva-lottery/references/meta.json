{
  "schemaVersion": 2,
  "name": "EvaLottery",
  "label": "轮播抽奖",
  "description": "抽奖组件，展示奖品轮播和抽奖按钮，支持次数型和积分型抽奖。提供4种模式：抽1/10次+中奖名单、抽1/10次、抽1次+中奖名单、仅抽1次。",
  "platform": "H5",
  "version": "1.3.8",
  "componentDir": "eva-lottery",
  "modes": [
    {
      "id": "mode1",
      "label": "标准抽奖（抽1/10次 + 中奖名单）",
      "fragment": "fragments/mode1.html",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/eva-lottery-mode1.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260806/d41d8cd98f00b204e9800998ecf8427e/k4aPJed4lL.svg",
      "wireframe": {
        "label": "标准抽奖",
        "variant": "lottery-mode1",
        "hasWinList": true,
        "hasTenDraw": true,
        "aspectRatio": "375/420",
        "format": "svg"
      }
    },
    {
      "id": "mode2",
      "label": "抽1/10次（无中奖名单）",
      "fragment": "fragments/mode2.html",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/eva-lottery-mode2.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260806/d41d8cd98f00b204e9800998ecf8427e/SmQW1knK4Q.svg",
      "wireframe": {
        "label": "抽1/10次",
        "variant": "lottery-mode2",
        "hasWinList": false,
        "hasTenDraw": true,
        "aspectRatio": "375/300",
        "format": "svg"
      }
    },
    {
      "id": "mode3",
      "label": "抽1次 + 中奖名单",
      "fragment": "fragments/mode3.html",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/eva-lottery-mode3.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260806/d41d8cd98f00b204e9800998ecf8427e/MNhQyyIp9o.svg",
      "wireframe": {
        "label": "抽1次 + 中奖名单",
        "variant": "lottery-mode3",
        "hasWinList": true,
        "hasTenDraw": false,
        "aspectRatio": "375/400",
        "format": "svg"
      }
    },
    {
      "id": "mode4",
      "label": "简洁抽奖（仅抽1次）",
      "fragment": "fragments/mode4.html",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/eva-lottery-mode4.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260806/d41d8cd98f00b204e9800998ecf8427e/Ep2Kk1bUj5.svg",
      "wireframe": {
        "label": "简洁抽奖",
        "variant": "lottery-mode4",
        "hasWinList": false,
        "hasTenDraw": false,
        "aspectRatio": "375/280",
        "format": "svg"
      }
    }
  ],
  "dataFields": [
    {
      "key": "lotteryId",
      "label": "抽奖活动ID",
      "type": "string",
      "required": true,
      "kind": "business-data",
      "sourceProp": "config.lottery_id",
      "description": "后台创建的抽奖活动 SID，用于调用抽奖、获取奖品列表、获取抽奖次数、获取中奖名单等全部接口"
    },
    {
      "key": "activityId",
      "label": "活动页面ID",
      "type": "string",
      "required": false,
      "kind": "business-data",
      "sourceProp": "config.activity_id",
      "description": "活动页面 ID，用于「我的中奖记录」跳转链接拼接及关注抽奖的 page_id 上报"
    },
    {
      "key": "openPrizePool",
      "label": "展示查看奖池入口",
      "type": "boolean",
      "required": false,
      "kind": "business-data",
      "sourceProp": "styleConfig.open_prize_pool",
      "description": "默认 true；关闭后不渲染「查看奖池」按钮"
    }
  ],
  "sourceDefaults": {
    "mode1": {
      "props": {
        "styleConfig.bgColor": "rgba(35, 211, 250, 1)",
        "styleConfig.majorTextColor": "rgba(255, 255, 255, 1)",
        "styleConfig.auxiliaryTextColor": "rgba(148, 153, 160, 1)",
