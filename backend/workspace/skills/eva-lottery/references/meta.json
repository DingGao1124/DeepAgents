        "src/EraLottery/normaModeIndex.vue"
      ],
      "notes": "组件宽度 750px（设计稿基准），内边距 10px 上下 25px 左右。头部高 80px 含次数和查看奖池入口。奖品区高 1.6rem 卡片。按钮区 72px 高。中奖名单区高 184px 滚动轮播。背景色默认 #3C3F69（无 bgColor 时），主文字 #fff，辅助文字 rgba(255,255,255,0.5)"
    },
    "mode2": {
