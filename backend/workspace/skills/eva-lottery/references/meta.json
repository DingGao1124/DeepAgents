      ],
      "notes": "mode3：仅有抽1次按钮（宽 8rem），有中奖名单。"
    },
    "mode4": {
      "props": {
        "styleConfig.bgColor": "rgba(35, 211, 250, 1)",
        "styleConfig.majorTextColor": "rgba(255, 255, 255, 1)",
        "styleConfig.auxiliaryTextColor": "rgba(148, 153, 160, 1)",
        "styleConfig.popBgColor": "rgba(255, 255, 255, 0.8)",
        "styleConfig.popFontColor": "rgba(51, 51, 51, 1)",
        "styleConfig.btnColor": "rgba(255, 255, 255, 0.2)",
        "styleConfig.btnTextColor": "rgba(255, 255, 255, 0.2)"
