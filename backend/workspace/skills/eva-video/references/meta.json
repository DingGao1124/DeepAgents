{
  "schemaVersion": 2,
  "name": "EvaVideo",
  "label": "视频",
  "description": "自动播放静音循环视频，播放失败时展示业务兜底图",
  "platform": "H5/PC",
  "version": "1.0.32",
  "componentDir": "eva-video",
  "modes": [
    {
      "id": "mode1",
      "label": "标准视频",
      "fragment": "fragments/mode1.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260805/d41d8cd98f00b204e9800998ecf8427e/Ad3Ml61662.svg",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/eva-video-mode1.html",
      "wireframe": {
        "label": "视频组件",
        "variant": "video",
        "state": "default",
        "aspectRatio": "16/9",
        "format": "svg"
      }
    }
  ],
  "dataFields": [
    {
      "key": "videoSrc",
      "label": "视频地址",
      "type": "string",
      "required": true,
      "kind": "business-asset",
      "sourceProp": "video.src",
      "description": "需要播放的真实视频 URL"
    },
    {
      "key": "imgSrc",
      "label": "兜底图片",
      "type": "string",
      "required": true,
      "kind": "business-asset",
      "sourceProp": "video.imgSrc",
      "description": "加载中及无法播放时展示的真实业务图片"
    },
    {
      "key": "posterSrc",
      "label": "海报帧",
      "type": "string",
      "required": false,
      "kind": "business-asset",
      "sourceProp": "video.posterSrc",
      "description": "视频元素的可选 poster 图片"
    }
  ],
  "sourceDefaults": {
    "mode1": {
      "objectFit": "cover",
      "container": {
        "position": "relative",
        "width": "由父容器/最终视觉决定",
        "height": "由父容器/最终视觉决定"
      },
      "media": {
        "width": "100%",
        "height": "100%",
        "videoPosition": "relative",
        "imagePosition": "absolute"
      },
      "notes": "源码未设置背景色、overflow、固定宽高、圆角或阴影"
    }
  },
  "previewData": {
    "mode1": {
      "videoSrc": "",
      "imgSrc": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260805/d41d8cd98f00b204e9800998ecf8427e/3wWanCt2Nc.svg",
      "posterSrc": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260805/d41d8cd98f00b204e9800998ecf8427e/3wWanCt2Nc.svg"
    }
  }
}
