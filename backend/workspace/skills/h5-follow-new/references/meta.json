{
  "schemaVersion": 2,
  "name": "H5FollowNew",
  "label": "H5关注",
  "description": "支持单UP主关注和多UP主关注列表，可选取关、过滤和换一换行为",
  "platform": "H5",
  "version": "0.9.9",
  "componentDir": "h5-follow-new",
  "modes": [
    {
      "id": "mode1",
      "label": "单UP主关注",
      "fragment": "fragments/mode1.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260805/d41d8cd98f00b204e9800998ecf8427e/JgJ8zsObRC.png",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/h5-follow-new-mode1.html"
    },
    {
      "id": "mode2",
      "label": "多UP主关注列表",
      "fragment": "fragments/mode2.html",
      "previewImage": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260806/d41d8cd98f00b204e9800998ecf8427e/FS72LKsVYS.png",
      "fragmentUrl": "https://activity.hdslb.com/blackboard/static/d41d8cd98f00b204e9800998ecf8427e/h5-follow-new-mode2.html"
    }
  ],
  "dataFields": [
    {
      "key": "uid",
      "label": "UP主UID",
      "type": "string",
      "required": false,
      "requiredForModes": [
        "mode1"
      ],
      "kind": "business-data",
      "sourceProp": "uid",
      "description": "mode1 的关注目标"
    },
    {
      "key": "uname",
      "label": "UP主昵称",
      "type": "string",
      "required": false,
      "requiredForModes": [
        "mode1"
      ],
      "kind": "business-data",
      "sourceProp": "uname",
      "description": "mode1 展示的真实昵称；由编辑器根据 uid 自动填充，无需手动输入"
    },
    {
      "key": "face",
      "label": "UP主头像",
      "type": "string",
      "required": false,
      "requiredForModes": [
        "mode1"
      ],
      "kind": "business-asset",
      "sourceProp": "face",
      "description": "mode1 展示的真实头像 URL；由编辑器根据 uid 自动填充，无需手动输入"
    },
    {
      "key": "followUidList",
      "label": "UP主列表",
      "type": "object[]",
      "required": false,
      "requiredForModes": [
        "mode2"
      ],
      "kind": "business-data",
      "sourceProp": "followUidList",
      "multiple": true,
      "items": {
        "uid": {
          "type": "string",
          "required": true
        },
        "uname": {
          "type": "string",
          "required": true
        },
        "face": {
          "type": "string",
          "required": true
        }
      },
      "description": "mode2 的真实UP主数据；face 是每项的业务素材"
    },
    {
      "key": "unfollow",
      "label": "允许取关",
      "type": "boolean",
      "required": false,
      "kind": "business-data",
      "sourceProp": "unfollow",
      "description": "默认 true；关闭后已关注按钮不可触发取关"
    },
    {
      "key": "showUpCount",
      "label": "每批展示数量",
      "type": "number",
      "required": false,
      "availableForModes": [
        "mode2"
      ],
      "kind": "business-data",
      "sourceProp": "showUpCount",
      "description": "默认 3；仅在换一换行为中限制每批数量"
    },
    {
      "key": "exChange",
      "label": "启用换一换",
      "type": "boolean",
      "required": false,
      "availableForModes": [
        "mode2"
      ],
      "kind": "business-data",
      "sourceProp": "exChange",
      "description": "默认 false；开启后随机展示一批UP主"
    },
    {
      "key": "filterFollowedUp",
      "label": "过滤已关注UP主",
      "type": "boolean",
      "required": false,
      "availableForModes": [
        "mode2"
      ],
      "kind": "business-data",
      "sourceProp": "filterFollowedUp",
      "description": "默认 false；开启后过滤已关注账号和本人"
    }
  ],
  "sourceDefaults": {
    "mode1": {
      "layout": "纵向居中",
      "avatar": "80px圆形",
      "name": "120×20px",
      "button": "80×24px",
      "primaryColor": "#fb7299",
      "rowGap": 0
    },
    "mode2": {
      "layout": "三列网格",
      "avatar": "80px圆形",
      "cardWidth": "120px",
      "rowGap": "16px",
      "button": "80×24px",
      "exchangeButton": "84×25px",
      "primaryColor": "#fb7299"
    }
  },
  "previewData": {
    "mode1": {
      "uid": "1",
      "uname": "示例UP主",
      "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png",
      "unfollow": true
    },
    "mode2": {
      "followUidList": [
        {
          "uid": "1",
          "uname": "示例UP主A",
          "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png"
        },
        {
          "uid": "2",
          "uname": "示例UP主B",
          "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png"
        },
        {
          "uid": "3",
          "uname": "示例UP主C",
          "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png"
        },
        {
          "uid": "4",
          "uname": "示例UP主D",
          "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png"
        },
        {
          "uid": "5",
          "uname": "示例UP主E",
          "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png"
        },
        {
          "uid": "6",
          "uname": "示例UP主F",
          "face": "https://i0.hdslb.com/bfs/activity-plat/static/10613/11875/11876/20260803/53704fc8d3ac45ac4b9a45153a694277/G7vBWPGExB.png"
        }
      ],
      "showUpCount": 3,
      "exChange": true,
      "filterFollowedUp": false,
      "unfollow": true
    }
  },
  "formActions": [
    {
      "trigger": {
        "field": "uid",
        "on": "change"
      },
      "api": {
        "url": "//manager.bilibili.co/x/admin/activity/user/cards/info",
        "params": {
          "mids": "{{uid}}"
        }
      },
      "response": {
        "mapping": [
          {
            "from": "data.cards.{{uid}}.name",
            "to": "uname"
          },
          {
            "from": "data.cards.{{uid}}.face",
            "to": "face"
          }
        ]
      }
    },
    {
      "trigger": {
        "field": "followUidList.*.uid",
        "on": "change"
      },
      "api": {
        "url": "//manager.bilibili.co/x/admin/activity/user/cards/info",
        "params": {
          "mids": "{{followUidList.*.uid}}"
        }
      },
      "response": {
        "mapping": [
          {
            "from": "data.cards.{{followUidList.*.uid}}.name",
            "to": "followUidList.*.uname"
          },
          {
            "from": "data.cards.{{followUidList.*.uid}}.face",
            "to": "followUidList.*.face"
          }
        ]
      }
    }
  ],
  "crossComponentEvents": [
    {
      "direction": "emit",
      "event": "FOLLOW_INFO_READY",
      "transport": "eva-event-bus",
      "payload": "number[]",
      "description": "共享已关注UID列表"
    },
    {
      "direction": "listen",
      "event": "FOLLOW_INFO_READY",
      "transport": "eva-event-bus",
      "payload": "number[]",
      "description": "同步其他关注实例的已关注状态"
    },
    {
      "direction": "emit",
      "event": "SUMMER_FITNESS_FOLLOW_SEND_POINTS",
      "transport": "eva-event-bus",
      "payload": "true",
      "description": "保留源码兼容事件，关注成功后触发"
    }
  ]
}
